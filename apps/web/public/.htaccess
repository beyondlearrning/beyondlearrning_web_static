# Beyond Learrning — Hostinger / Apache
# Put this in public_html next to index.html

DirectoryIndex index.html index.htm

RewriteEngine On
RewriteBase /

# If someone opens /about (no slash) and /about/index.html exists → /about/
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_URI} !/$
RewriteCond %{DOCUMENT_ROOT}/%{REQUEST_URI}/index.html -f
RewriteRule ^(.*)$ $1/ [L,R=301]

# Direct file hits (css/js/images/html) — leave alone
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# Folder with index.html — leave alone (Apache serves index)
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^ - [L]

# Legacy flat files: /about → /about.html (if still present)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

ErrorDocument 404 /404.html
